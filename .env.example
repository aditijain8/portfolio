# Copy to .env (never commit .env). All values here are placeholders.

# --- Database ---
DB_PASSWORD=change-me-to-a-long-random-string

# --- One-time administrator bootstrap (see docs/ADMIN_SETUP.md) ---
# Used ONLY when no administrator exists yet. Remove ADMIN_PASSWORD after the first successful start.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=
# Set to true (once) together with ADMIN_PASSWORD to reset a forgotten password, then set back to false.
ADMIN_RESET=false

# --- Application ---
APP_PUBLIC_URL=http://localhost:5173
STORAGE_TYPE=database            # database (default, survives redeploys) | local (needs a persistent volume)
API_DOCS_ENABLED=true            # Swagger UI at /swagger-ui.html; keep false in production
CONTACT_ENABLED=true

# --- Production only (see docs/DEPLOYMENT.md) ---
# COOKIE_SECURE=true             # required behind HTTPS
# CORS_ALLOWED_ORIGINS=          # leave empty when the frontend proxies /api (recommended)
# SESSION_TIMEOUT=60m
# LOGIN_MAX_FAILURES=5
# LOGIN_WINDOW_MINUTES=15

# --- Optional contact e-mail notifications (disabled unless all are set) ---
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# CONTACT_NOTIFY_EMAIL=you@example.com
# CONTACT_FROM_EMAIL=portfolio@example.com
